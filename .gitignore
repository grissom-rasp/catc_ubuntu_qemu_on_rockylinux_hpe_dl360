# Secrets
.ssh-env

# Generated cloud-init artifacts (contain substituted credentials)
cloud-init/user-data
cloud-init/*.iso
vm-ubuntu26/seed.iso
vm-ubuntu26/user-data

# Logs and runtime output
logs/
*.log

# Claude local state
.claude/

# Exported session transcripts (the conversation export contains the password)
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# VM images
*.qcow2
*.img
*.raw

# Downloaded install media / cloud images (large; do not commit)
downloads/

# Host inventory dumps — contain serial numbers, UUIDs, MACs, sudoers,
# full passwd/group and journal excerpts. Local reference only; never push.
rockylinux_info/

# Guest inventory dumps — same sensitivity class as rockylinux_info/ (MAC,
# account lists, journal excerpts, internal addressing). Local only; never push.
vm-ubuntu24/ubuntu24_info/
